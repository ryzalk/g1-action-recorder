# Copy to .env (git ignores it). Everything works without it; each speech key turns on its Speech page.

# Speech: BytePlus (Seed TTS 2.0) and MiniMax (T2A v2)
BYTEPLUS_API_KEY=
MINIMAX_API_KEY=

# Optional: other endpoints
# BYTEPLUS_API_BASE_URL=https://voice.ap-southeast-1.bytepluses.com
# BYTEPLUS_TTS_RESOURCE_ID=seed-tts-2.0
# MINIMAX_API_BASE_URL=https://api.minimax.io

# Optional: ports and data folder
# G1_RECORDER_PORT=8930              # the page and the API
# G1_RECORDER_VISER_PORT=8931        # the robot's 3D view
# G1_RECORDER_MAP_VISER_PORT=8932    # the map's 3D view
# G1_RECORDER_DATA_DIR=./data        # poses, actions, speech clips and samples, maps
